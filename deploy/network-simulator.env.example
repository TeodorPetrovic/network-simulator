# Copy to /etc/network-simulator/network-simulator.env and adjust paths.
# The systemd unit has safe defaults for bind and state directories.
NETWORK_SIMULATOR_BIND=127.0.0.1:3080
NETWORK_SIMULATOR_AUTH_ENABLED=true
# Leave unset/false with a reverse proxy. When auth is enabled, forwarded
# headers are ignored for authorization and bearer-token auth still applies.
# NETWORK_SIMULATOR_TRUST_PROXY_HEADERS_UNAUTH=false

NETWORK_SIMULATOR_DB=/var/lib/network-simulator/network-simulator.sqlite
NETWORK_SIMULATOR_DATA_HOME=/var/lib/network-simulator
NETWORK_SIMULATOR_IMAGE_HOME=/var/lib/network-simulator/images
NETWORK_SIMULATOR_APPLIANCES=/var/lib/network-simulator/appliances
NETWORK_SIMULATOR_QEMU_IMAGES=/var/lib/network-simulator/images/qemu
NETWORK_SIMULATOR_DYNAMIPS_IMAGES=/var/lib/network-simulator/images/dynamips
NETWORK_SIMULATOR_QEMU_STATE=/var/lib/network-simulator/run/qemu
NETWORK_SIMULATOR_QEMU_SOCKETS=/var/lib/network-simulator/run/qemu/sockets
NETWORK_SIMULATOR_DYNAMIPS_STATE=/var/lib/network-simulator/run/dynamips
NETWORK_SIMULATOR_DOCKER_STATE=/var/lib/network-simulator/run/docker
NETWORK_SIMULATOR_VPCS_STATE=/var/lib/network-simulator/run/vpcs
NETWORK_SIMULATOR_UBRIDGE_STATE=/var/lib/network-simulator/run/ubridge
NETWORK_SIMULATOR_CAPTURE_HOME=/var/lib/network-simulator/captures

# Enable only when a node runtime should stop after this many idle minutes.
# A project with an open WebSocket remains active.
# NETWORK_SIMULATOR_IDLE_STOP_MINUTES=60

# Optional runtime program overrides. Defaults are resolved from PATH and the
# service user's $NETWORK_SIMULATOR_DATA_HOME/bin directory where applicable.
# NETWORK_SIMULATOR_DOCKER=/usr/bin/docker
# NETWORK_SIMULATOR_QEMU=/usr/bin/qemu-system-x86_64
# NETWORK_SIMULATOR_QEMU_IMG=/usr/bin/qemu-img
# NETWORK_SIMULATOR_QEMU_CONFIG_DISK=/var/lib/network-simulator/images/config.img
# NETWORK_SIMULATOR_CPULIMIT=/usr/bin/cpulimit
# NETWORK_SIMULATOR_SWTPM=/usr/bin/swtpm
# NETWORK_SIMULATOR_OVMF_DIR=/usr/share/OVMF
# NETWORK_SIMULATOR_DYNAMIPS=/usr/bin/dynamips
# NETWORK_SIMULATOR_VPCS=/usr/local/bin/vpcs
# NETWORK_SIMULATOR_UBRIDGE=/usr/local/bin/ubridge
# NETWORK_SIMULATOR_XVFB=/usr/bin/Xvfb
# NETWORK_SIMULATOR_X11VNC=/usr/bin/x11vnc
# NETWORK_SIMULATOR_NAT_INTERFACE=virbr0
# NETWORK_SIMULATOR_ALLOW_HOST_INTERFACES=eth0,wlan0

# Test-only variables used by optional Rust integration tests. Do not set these
# in the running service environment.
# NETWORK_SIMULATOR_TEST_C3600_IMAGE=/path/to/c3620-ios-image
# NETWORK_SIMULATOR_TEST_DOCKER=/usr/bin/docker
# NETWORK_SIMULATOR_TEST_DOCKER_IMAGE=alpine:latest
# NETWORK_SIMULATOR_TEST_DYNAMIPS=/path/to/dynamips
# NETWORK_SIMULATOR_TEST_QEMU=/path/to/qemu-system-x86_64
# NETWORK_SIMULATOR_TEST_QEMU_IMG=/path/to/qemu-img
# NETWORK_SIMULATOR_TEST_QMP_PIDFILE=/tmp/qemu-test.pid
# NETWORK_SIMULATOR_TEST_QMP_SOCKET=/tmp/qemu-test.sock
# NETWORK_SIMULATOR_TEST_UBRIDGE=/path/to/ubridge
# NETWORK_SIMULATOR_TEST_VPCS=/path/to/vpcs
