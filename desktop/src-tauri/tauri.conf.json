{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Network Studio",
  "version": "0.1.0",
  "identifier": "rs.network-studio.desktop",
  "build": {
    "frontendDist": "../../frontend/dist/client",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "bun run --cwd ../frontend dev",
    "beforeBuildCommand": "bun run --cwd ../frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Network Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; frame-src http: https:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Desktop client for Network Studio",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "recommends": [
          "wireshark"
        ]
      }
    }
  }
}
